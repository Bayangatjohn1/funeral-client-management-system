# Local branch installation. Copy to .env only on a NEW branch server/database.
# Generate a fresh APP_KEY on this branch after filling the remaining values.
APP_NAME="Sabangan Caguioa Funeral Home System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__TRUSTED_LOCAL_BRANCH_HOSTNAME__
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_AUDIT_TIMEZONE=Asia/Manila

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=__NEW_EMPTY_BRANCH_DATABASE__
DB_USERNAME=__BRANCH_DATABASE_USER__
DB_PASSWORD=__BRANCH_DATABASE_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=__UNIQUE_BRANCH_CODE__-
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

BRANCH_SYNC_MODE=branch
BRANCH_SYNC_CODE=__EXISTING_BRANCH_CODE__
BRANCH_SYNC_CENTRAL_URL=https://sabangan-caguioa.com
BRANCH_SYNC_TOKEN=__64_CHARACTER_TOKEN_ISSUED_BY_CENTRAL__
BRANCH_SYNC_MAX_OFFLINE_HOURS=168
BRANCH_SYNC_TIMEOUT=120

BACKUP_DISK=local
BACKUP_DIRECTORY=system-backups
BACKUP_RETENTION_DAYS=14
DB_DUMP_BINARY=C:\xampp\mysql\bin\mysqldump.exe

MAIL_MAILER=log
MAIL_FROM_ADDRESS=__VALID_SYSTEM_EMAIL__
MAIL_FROM_NAME="${APP_NAME}"

FUNERAL_HISTORICAL_CASES_ENABLED=false
