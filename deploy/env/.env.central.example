# Hosted central installation. Copy to .env on the central server and replace every __PLACEHOLDER__.
# Preserve the existing production APP_KEY. Never generate a new key over an existing central database.
APP_NAME="Sabangan Caguioa Funeral Home System"
APP_ENV=production
APP_KEY=__PRESERVE_EXISTING_CENTRAL_APP_KEY__
APP_DEBUG=false
APP_URL=https://sabangan-caguioa.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_AUDIT_TIMEZONE=Asia/Manila

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=__CENTRAL_DATABASE__
DB_USERNAME=__CENTRAL_DATABASE_USER__
DB_PASSWORD=__CENTRAL_DATABASE_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=sabangan-central-
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

BRANCH_SYNC_MODE=central
BRANCH_SYNC_CODE=
BRANCH_SYNC_CENTRAL_URL=
BRANCH_SYNC_TOKEN=
BRANCH_SYNC_MAX_OFFLINE_HOURS=168
BRANCH_SYNC_TIMEOUT=120

BACKUP_DISK=local
BACKUP_DIRECTORY=system-backups
BACKUP_RETENTION_DAYS=14
BACKUP_DAILY_TIME=01:00
DB_DUMP_BINARY=__OPTIONAL_ABSOLUTE_MYSQLDUMP_PATH__

MAIL_MAILER=log
MAIL_FROM_ADDRESS=__VALID_SYSTEM_EMAIL__
MAIL_FROM_NAME="${APP_NAME}"

FUNERAL_HISTORICAL_CASES_ENABLED=false
